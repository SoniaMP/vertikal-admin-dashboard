generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

/// A season IS a calendar year. The row exists only so prices and
/// memberships have something to hang from; it is created the first time a
/// year needs it and never marked, dated or named. Which season is in force
/// is calculated — see `getActiveSeason()`.
model Season {
  id        String   @id @default(cuid())
  year      Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  licenseTypes          LicenseType[]
  licenseSubtypes       LicenseSubtype[]
  categories            Category[]
  supplements           Supplement[]
  supplementGroups      SupplementGroup[]
  offerings             LicenseOffering[]
  supplementPrices      SupplementPrice[]
  supplementGroupPrices SupplementGroupPrice[]
  memberships           Membership[]
}

model LicenseType {
  id          String    @id @default(cuid())
  /// The season this row belongs to. The catalog is per season: a change
  /// made in one year never reaches another unless the admin says so.
  seasonId    String
  /// Shared by every row descended from the same original, so a federation
  /// can be followed across years even after its name or price changed.
  lineageId   String
  name        String
  description String
  active      Boolean   @default(true)
  /// Null while the type is a draft, so it stays out of the public wizard
  /// until an admin publishes it. Set once and never cleared: retiring a
  /// published type is `active = false`, which is a different thing.
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  season          Season                       @relation(fields: [seasonId], references: [id])
  subtypes        LicenseSubtype[]
  offerings       LicenseOffering[]
  memberships     Membership[]
  supplementLinks LicenseTypeSupplement[]
  groupLinks      LicenseTypeSupplementGroup[]

  @@index([seasonId])
  @@index([lineageId])
}

model LicenseSubtype {
  id            String    @id @default(cuid())
  seasonId      String
  lineageId     String
  name          String
  description   String
  active        Boolean   @default(true)
  /// Same draft marker as on LicenseType: a new modality of an already
  /// published federation stays hidden until it has prices.
  publishedAt   DateTime?
  licenseTypeId String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  season      Season            @relation(fields: [seasonId], references: [id])
  licenseType LicenseType       @relation(fields: [licenseTypeId], references: [id])
  offerings   LicenseOffering[]
  memberships Membership[]

  @@index([seasonId])
  @@index([lineageId])
}

model Category {
  id          String   @id @default(cuid())
  seasonId    String
  lineageId   String
  name        String
  description String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  season      Season            @relation(fields: [seasonId], references: [id])
  offerings   LicenseOffering[]
  memberships Membership[]

  @@index([seasonId])
  @@index([lineageId])
}

model LicenseOffering {
  id         String @id @default(cuid())
  seasonId   String
  typeId     String
  subtypeId  String
  categoryId String
  price      Int // Price in cents

  season   Season         @relation(fields: [seasonId], references: [id])
  type     LicenseType    @relation(fields: [typeId], references: [id])
  subtype  LicenseSubtype @relation(fields: [subtypeId], references: [id])
  category Category       @relation(fields: [categoryId], references: [id])

  memberships Membership[]

  @@unique([seasonId, typeId, subtypeId, categoryId])
}

model SupplementGroup {
  id        String   @id @default(cuid())
  seasonId  String
  lineageId String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  season      Season                       @relation(fields: [seasonId], references: [id])
  supplements Supplement[]
  groupPrices SupplementGroupPrice[]
  typeLinks   LicenseTypeSupplementGroup[]

  @@index([seasonId])
  @@index([lineageId])
}

model Supplement {
  id                String   @id @default(cuid())
  seasonId          String
  lineageId         String
  name              String
  description       String
  active            Boolean  @default(true)
  supplementGroupId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  season                Season                  @relation(fields: [seasonId], references: [id])
  supplementGroup       SupplementGroup?        @relation(fields: [supplementGroupId], references: [id])
  prices                SupplementPrice[]
  membershipSupplements MembershipSupplement[]
  typeLinks             LicenseTypeSupplement[]

  @@index([seasonId])
  @@index([lineageId])
}

model SupplementPrice {
  id           String @id @default(cuid())
  seasonId     String
  supplementId String
  price        Int // Price in cents

  season     Season     @relation(fields: [seasonId], references: [id])
  supplement Supplement @relation(fields: [supplementId], references: [id])

  @@unique([seasonId, supplementId])
}

model SupplementGroupPrice {
  id       String @id @default(cuid())
  seasonId String
  groupId  String
  price    Int // Price in cents (charged once for any combo in the group)

  season Season          @relation(fields: [seasonId], references: [id])
  group  SupplementGroup @relation(fields: [groupId], references: [id])

  @@unique([seasonId, groupId])
}

// ──────────────────────────────────────────────
// Which federations offer which extras
//
// The unit that carries a price is the unit that carries federations: a
// standalone supplement is linked on its own, a grouped one is never linked
// at all because its group decides. A supplement is either standalone or
// grouped, never both — the club creates two supplements when it wants to
// sell the same thing inside a group and apart from it.
//
// No `seasonId` here: both sides already belong to one, and the only writers
// pair rows from the same season. Links are read through the season's types.
// ──────────────────────────────────────────────
model LicenseTypeSupplement {
  typeId       String
  supplementId String

  type       LicenseType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  supplement Supplement  @relation(fields: [supplementId], references: [id], onDelete: Cascade)

  @@id([typeId, supplementId])
  @@index([supplementId])
}

model LicenseTypeSupplementGroup {
  typeId  String
  groupId String

  type  LicenseType     @relation(fields: [typeId], references: [id], onDelete: Cascade)
  group SupplementGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([typeId, groupId])
  @@index([groupId])
}

// ──────────────────────────────────────────────
// Member: person identity (DNI unique)
// ──────────────────────────────────────────────
model Member {
  id          String   @id @default(cuid())
  dni         String   @unique
  firstName   String
  lastName    String
  email       String
  phone       String
  dateOfBirth String
  sex         String
  address     String
  city        String
  postalCode  String
  province    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships Membership[]

  @@index([dni])
  @@index([email])
  @@index([lastName, firstName])
}

// ──────────────────────────────────────────────
// Membership: annual instance per member
// Status: PENDING_PAYMENT | ACTIVE | EXPIRED | CANCELLED
// PaymentStatus: PENDING | COMPLETED | FAILED | REFUNDED
// ──────────────────────────────────────────────
model Membership {
  id                        String    @id @default(cuid())
  memberId                  String
  seasonId                  String
  status                    String    @default("PENDING_PAYMENT")
  typeId                    String?
  subtypeId                 String?
  categoryId                String?
  offeringId                String?
  licensePriceSnapshot      Int       @default(0)
  licenseLabelSnapshot      String    @default("")
  isFederated               Boolean   @default(false)
  hasClubLicense            Boolean   @default(true)
  externalLicenseLabel      String?
  externalLicenseFileUrl    String?
  externalLicenseVerifiedAt DateTime?
  totalAmount               Int
  paymentStatus             String    @default("PENDING")
  stripeSessionId           String?
  stripePaymentId           String?
  confirmationSent          Boolean   @default(false)
  consentedAt               DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  member      Member                 @relation(fields: [memberId], references: [id], onDelete: Cascade)
  season      Season                 @relation(fields: [seasonId], references: [id])
  type        LicenseType?           @relation(fields: [typeId], references: [id])
  subtype     LicenseSubtype?        @relation(fields: [subtypeId], references: [id])
  offering    LicenseOffering?       @relation(fields: [offeringId], references: [id])
  category    Category?              @relation(fields: [categoryId], references: [id])
  supplements MembershipSupplement[]

  @@unique([memberId, seasonId])
  @@index([seasonId, status])
  @@index([seasonId, paymentStatus])
  @@index([stripeSessionId])
}

// ──────────────────────────────────────────────
// MembershipSupplement: junction with price snapshot
// ──────────────────────────────────────────────
model MembershipSupplement {
  membershipId String
  supplementId String
  priceAtTime  Int

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  supplement Supplement @relation(fields: [supplementId], references: [id])

  @@id([membershipId, supplementId])
}

// ──────────────────────────────────────────────
// Auth: User / Role / UserRole
// ──────────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roles   UserRole[]
  courses CourseCatalog[]
}

model Role {
  id   String @id @default(cuid())
  name String @unique // e.g. "ADMIN", "MANAGER"

  users UserRole[]
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model AppSetting {
  key   String @id
  value String
}

// ──────────────────────────────────────────────
// Courses: types, catalog, pricing, registrations
// ──────────────────────────────────────────────
model CourseType {
  id     String  @id @default(cuid())
  name   String
  active Boolean @default(true)

  courses CourseCatalog[]
}

model CourseCatalog {
  id                   String    @id @default(cuid())
  title                String
  slug                 String
  courseDate           DateTime
  registrationDeadline DateTime
  courseTypeId         String
  status               String    @default("ACTIVE")
  instructorId         String?
  maxCapacity          Int
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  courseType    CourseType           @relation(fields: [courseTypeId], references: [id])
  instructor    User?                @relation(fields: [instructorId], references: [id])
  prices        CoursePrice[]
  registrations CourseRegistration[]

  @@index([courseDate])
  @@index([status, courseDate])
  @@index([instructorId])
}

model CoursePrice {
  id              String  @id @default(cuid())
  courseCatalogId String
  name            String
  amountCents     Int
  isActive        Boolean @default(true)

  courseCatalog CourseCatalog        @relation(fields: [courseCatalogId], references: [id], onDelete: Cascade)
  registrations CourseRegistration[]
}

model CourseRegistration {
  id                    String   @id @default(cuid())
  courseCatalogId       String
  coursePriceId         String
  firstName             String
  lastName              String
  email                 String
  phone                 String?
  dni                   String?
  dateOfBirth           String?
  address               String?
  city                  String?
  postalCode            String?
  province              String?
  licenseType           String?
  licenseFileUrl        String?
  paymentStatus         String   @default("PENDING")
  stripeSessionId       String?
  stripePaymentIntentId String?
  confirmationSent      Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  courseCatalog CourseCatalog @relation(fields: [courseCatalogId], references: [id])
  coursePrice   CoursePrice   @relation(fields: [coursePriceId], references: [id])

  @@index([courseCatalogId, paymentStatus])
  @@index([stripeSessionId])
  @@map("courses")
}

/// Short-lived code that lets a returning member recover their own stored data
/// on the public renewal screen. Keyed by DNI rather than by member so the
/// lookup never has to reveal whether that member exists.
model RenewalCode {
  id        String   @id @default(cuid())
  dni       String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([dni])
}
